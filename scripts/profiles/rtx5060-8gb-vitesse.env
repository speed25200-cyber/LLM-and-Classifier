# RTX 5060 8 Go - vitesse : Bonsai-27B 1-bit (Q1_0, 3,53 Gio) ~1,2x plus rapide que Bonsai 2 PTQ1_0 (53-65 tok/s
# estimes), moins precis (89,5 % de Qwen3.6-27B) ; le classifieur tient alors sur le GPU (decisions ~0,05-0,15 s).
BONSAI_FAMILY=bonsai
BONSAI_BAND=Q1_0
BONSAI_CTX=16384
BONSAI_NGL=99
BONSAI_KV4=1
BONSAI_MMPROJ=cpu
BONSAI_NP=1
BONSAI_REASONING_BUDGET=2048
BONSAI_PORT=8080
JEV_MODE=dual
JEV_FAMILY=ternary
JEV_SIZE=1.7B
JEV_CTX=8192
JEV_NGL=99
JEV_NP=4
JEV_PORT=8081
