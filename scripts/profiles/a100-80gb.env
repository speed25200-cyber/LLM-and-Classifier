# A100 80 Go (Colab Pro / datacenter) : "usine" de distillation + entrainement, et banc d'evaluation de la fusion.
# Ampere : PQ2_0 est plus rapide que PTQ1_0 (livre blanc A100 SXM : 74 tok/s / 1328 pp512 contre 55 / 703).
# Contexte long en KV f16, vision sur GPU, 4 slots pour paralleliser la distillation.
BONSAI_FAMILY=bonsai2
BONSAI_BAND=PQ2_0
BONSAI_CTX=65536
BONSAI_NGL=99
BONSAI_KV4=0
BONSAI_MMPROJ=gpu
BONSAI_NP=4
BONSAI_REASONING_BUDGET=-1
BONSAI_CACHE_RAM=8192
BONSAI_PORT=8080
JEV_MODE=dual
JEV_FAMILY=ternary
JEV_SIZE=8B
JEV_CTX=8192
JEV_NGL=99
JEV_NP=8
JEV_PORT=8081
