# RTX 4060 8 Go - mode mono : UN seul serveur. Bonsai 2 27B sert a la fois de System Two (generation)
# et de System One (lecture des probabilites par grammaire, sans generation). Meilleure qualite de
# decision, aucune VRAM supplementaire, mais 3 a 10x plus lent qu'un petit clone dedie.
BONSAI_FAMILY=bonsai2
BONSAI_BAND=PTQ1_0
BONSAI_CTX=8192
BONSAI_NGL=99
BONSAI_KV4=1
BONSAI_MMPROJ=cpu
BONSAI_NP=2                # slots de 8 k chacun : 1 pour la generation, 1 pour les lectures System One (comme le mode mono du Studio)
BONSAI_REASONING_BUDGET=2048
BONSAI_PORT=8080
JEV_MODE=mono
JEV_PORT=8080
