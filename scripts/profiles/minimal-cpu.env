# Materiel minimal : PAS de GPU, 8 a 16 Go de RAM, 4 coeurs ou plus.
# System Two : Bonsai-8B 1-bit (1.07 Gio) ~20 tok/s sur un i7 8 coeurs ; System One : Ternary-Bonsai-1.7B.
# Avec 16 Go de RAM on peut tenter BONSAI_FAMILY=bonsai BONSAI_SIZE=27B (3.5 Gio, ~5-10 tok/s).
BONSAI_FAMILY=bonsai
BONSAI_SIZE=8B
BONSAI_BAND=Q1_0
BONSAI_CTX=4096
BONSAI_NGL=0
BONSAI_KV4=0
BONSAI_MMPROJ=off
BONSAI_NP=1
BONSAI_REASONING_BUDGET=512
BONSAI_PORT=8080
JEV_MODE=dual
JEV_FAMILY=ternary
JEV_SIZE=1.7B
JEV_CTX=4096
JEV_NGL=0
JEV_NP=1
JEV_PORT=8081
