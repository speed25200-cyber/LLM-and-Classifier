# RTX 5060 Ti 16 Go : Bonsai 2 27B PQ2_0 (prefill ~2x plus rapide que PTQ1_0) + vision sur GPU, KV q8_0, 32 k
# (jusqu'a 128 k en priorite "contexte"), classifieur Ternary-Bonsai-4B sur GPU. Mesure communautaire la plus
# proche : 44,4 tok/s et 1 029 tok/s de prefill (Ternary-Bonsai 27B PQ2_0 sur cette carte).
BONSAI_FAMILY=bonsai2
BONSAI_BAND=PQ2_0
BONSAI_CTX=32768
BONSAI_NGL=99
BONSAI_KV_TYPE=q8_0
BONSAI_MMPROJ=gpu
BONSAI_NP=1
BONSAI_REASONING_BUDGET=4096
BONSAI_PORT=8080
JEV_MODE=dual
JEV_FAMILY=ternary
JEV_SIZE=4B
JEV_CTX=8192
JEV_NGL=99
JEV_NP=4
JEV_PORT=8081
