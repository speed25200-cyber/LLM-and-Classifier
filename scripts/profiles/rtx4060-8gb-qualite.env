# Profil recommande : RTX 4060 8 Go (ou toute carte 8 Go) - qualite maximale
# System Two : Bonsai 2 27B (ternaire QAT de Qwen3.8-27B), packing PTQ1_0 = 5.93 Go de poids
# System One : Ternary-Bonsai-1.7B (0.37 Go) sur le GPU ; passer JEV_NGL=0 si "out of memory"
# Budget VRAM estime : Bonsai ~6.6 Gio (poids 5.5 + tampons ~0.9 + KV q4 8K ~0.15) + Jev ~0.6 Gio = ~7.2 Gio
BONSAI_FAMILY=bonsai2
BONSAI_BAND=PTQ1_0
BONSAI_CTX=8192
BONSAI_NGL=99
BONSAI_KV4=1
BONSAI_MMPROJ=cpu          # off | cpu | gpu  (le projecteur vision coute ~0.6-0.9 Gio de VRAM)
BONSAI_NP=1
BONSAI_REASONING_BUDGET=2048
BONSAI_PORT=8080
JEV_MODE=dual              # dual = petit modele dedie ; mono = Bonsai repond aussi aux questions System One
JEV_FAMILY=ternary
JEV_SIZE=1.7B
JEV_CTX=4096
JEV_NGL=99
JEV_NP=2
JEV_PORT=8081
