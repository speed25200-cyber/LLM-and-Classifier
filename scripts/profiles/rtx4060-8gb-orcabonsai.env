# RTX 4060 8 Go, qualite, avec l'adaptateur OrcaBonsai (ablation de refus a l'execution sur Bonsai 2 27B).
# Identique a rtx4060-8gb-qualite.env + BONSAI_LORA. Lancer d'abord ./scripts/fetch_orcabonsai.sh.
# Le clone System One reste inchange ; en mode mono, mettre "lora": [{"id": 0, "scale": 0}] par requete
# pour lire les probabilites sur le modele publie (voir docs/08-ORCABONSAI-UNCENSORED.md).
BONSAI_FAMILY=bonsai2
BONSAI_BAND=PTQ1_0
BONSAI_CTX=8192
BONSAI_NGL=99
BONSAI_KV4=1
BONSAI_MMPROJ=cpu
BONSAI_NP=1
BONSAI_REASONING_BUDGET=2048
BONSAI_PORT=8080
BONSAI_LORA=third_party/orcabonsai/gguf/bonsai-abliterate-lora.gguf
BONSAI_LORA_SCALE=1.0
JEV_MODE=dual
JEV_FAMILY=ternary
JEV_SIZE=1.7B
JEV_CTX=4096
JEV_NGL=99
JEV_NP=2
JEV_PORT=8081
